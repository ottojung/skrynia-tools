(module
 (import "skrynia" "invoke" (func $invoke(param i32 i32 i32 i32)(result i32)))
 (import "skrynia" "write" (func $write(param i32 i32 i32)(result i32)))
 (memory(export "memory") 1)
 (data(i32.const 0) "\01\0f\00\00\00records/new.bin\0e\00\00\00")
 (data(i32.const 128) "disk-write")
 (data(i32.const 160) "OK")
 (func(export "skrynia_main")(param $input i32)(param $output i32)(result i32)
  (local $fd i32)(local $n i32)
  (if (i32.ne(call $invoke(i32.const 0)(i32.const 24)
      (i32.const 256)(i32.const 4))(i32.const 4))
    (then(return(i32.const -5))))
  (local.set $fd(i32.load(i32.const 256)))
  (if (i32.lt_s(local.get $fd)(i32.const 0))
    (then(return(local.get $fd))))
  (i32.store8(i32.const 32)(i32.const 3))
  (i32.store(i32.const 33)(local.get $fd))
  (i32.store(i32.const 37)(i32.const 10))
  (memory.copy(i32.const 41)(i32.const 128)(i32.const 10))
  (if (i32.ne(call $invoke(i32.const 32)(i32.const 19)
      (i32.const 300)(i32.const 4))(i32.const 4))
    (then(return(i32.const -5))))
  (local.set $n(i32.load(i32.const 300)))
  (if (i32.ne(local.get $n)(i32.const 10))
    (then(return(i32.const -5))))
  (i32.store8(i32.const 64)(i32.const 4))
  (i32.store(i32.const 65)(local.get $fd))
  (if (i32.ne(call $invoke(i32.const 64)(i32.const 5)
      (i32.const 320)(i32.const 4))(i32.const 4))
    (then(return(i32.const -5))))
  (if (i32.lt_s(i32.load(i32.const 320))(i32.const 0))
    (then(return(i32.const -5))))
  (drop(call $write(local.get $output)(i32.const 160)(i32.const 2)))
  (i32.const 0)))
