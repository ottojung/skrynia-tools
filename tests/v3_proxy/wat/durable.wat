(module
 (import "skrynia" "invoke" (func $invoke (param i32 i32 i32 i32)(result i32)))
 (import "skrynia" "write" (func $write (param i32 i32 i32)(result i32)))
 (memory (export "memory") 1)
 (data (i32.const 1024) "records/staged")
 (data (i32.const 1056) "records/public.txt")
 (data (i32.const 1100) "records/new")
 (data (i32.const 1140) "records/obsolete")
 (data (i32.const 1180) "records")
 (data (i32.const 1200) "durable")
 (data (i32.const 1220) "OK")
 (func $call (param $len i32)(result i32)
    (local $n i32)
    (local.set $n (call $invoke (i32.const 0)(local.get $len)(i32.const 2048)(i32.const 256)))
    (if (i32.lt_s (local.get $n)(i32.const 4)) (then (return (i32.const -99))))
    (i32.load (i32.const 2048)))
 (func $path (param $op i32)(param $ptr i32)(param $len i32)(result i32)
    (i32.store8 (i32.const 0)(local.get $op))
    (i32.store (i32.const 1)(local.get $len))
    (memory.copy (i32.const 5)(local.get $ptr)(local.get $len))
    (call $call (i32.add (local.get $len)(i32.const 5))))
 (func $fd (param $op i32)(param $fd i32)(result i32)
    (i32.store8 (i32.const 0)(local.get $op))
    (i32.store (i32.const 1)(local.get $fd))
    (call $call (i32.const 5)))
 (func $rename (result i32)
    (i32.store8 (i32.const 0)(i32.const 7))
    (i32.store (i32.const 1)(i32.const 14))
    (memory.copy (i32.const 5)(i32.const 1024)(i32.const 14))
    (i32.store (i32.const 19)(i32.const 18))
    (memory.copy (i32.const 23)(i32.const 1056)(i32.const 18))
    (call $call (i32.const 41)))
 (func $openstaged (result i32)
    (i32.store8 (i32.const 0)(i32.const 1))
    (i32.store (i32.const 1)(i32.const 14))
    (memory.copy (i32.const 5)(i32.const 1024)(i32.const 14))
    (i32.store (i32.const 19)(i32.const 15))
    (call $call (i32.const 23)))
 (func $mkdir (result i32)
    (i32.store8 (i32.const 0)(i32.const 6))
    (i32.store (i32.const 1)(i32.const 11))
    (memory.copy (i32.const 5)(i32.const 1100)(i32.const 11))
    (i32.store (i32.const 16)(i32.const 4))
    (call $call (i32.const 20)))
 (func $writefile (param $fd i32)(result i32)
    (i32.store8 (i32.const 0)(i32.const 3))
    (i32.store (i32.const 1)(local.get $fd))
    (i32.store (i32.const 5)(i32.const 7))
    (memory.copy (i32.const 9)(i32.const 1200)(i32.const 7))
    (call $call (i32.const 16)))
 (func $random (result i32)
    (local $n i32)
    (i32.store8 (i32.const 0)(i32.const 12))
    (i32.store (i32.const 1)(i32.const 128))
    (local.set $n (call $invoke (i32.const 0)(i32.const 5)
                  (i32.const 2048)(i32.const 256)))
    (if (i32.ne (local.get $n)(i32.const 20))
       (then(return(i32.const -5))))
    (i32.load (i32.const 2048)))
 (func $next (param $fd i32)(result i32)
    (local $n i32)
    (i32.store8(i32.const 0)(i32.const 10))
    (i32.store(i32.const 1)(local.get $fd))
    (i32.store(i32.const 5)(i32.const 128))
    (local.set $n (call $invoke (i32.const 0)(i32.const 9)
                  (i32.const 2048)(i32.const 256)))
    (if (i32.lt_s(local.get $n)(i32.const 5))
       (then(return(i32.const -5))))
    (if (i32.le_s(i32.load(i32.const 2048))(i32.const 0))
       (then(return(i32.const -5))))
    (i32.const 0))
 (func (export "skrynia_main") (param $input i32)(param $output i32)(result i32)
    (local $fd i32)(local $dir i32)
    (if (i32.ne (call $mkdir)(i32.const 0))(then(return(i32.const -5))))
    (local.set $fd(call $openstaged))
    (if (i32.lt_s(local.get $fd)(i32.const 0))(then(return(local.get $fd))))
    (if (i32.ne(call $writefile(local.get $fd))(i32.const 7))
       (then(return(i32.const -5))))
    (if (i32.ne(call $fd(i32.const 5)(local.get $fd))(i32.const 0))
       (then(return(i32.const -5))))
    (if (i32.ne(call $fd(i32.const 4)(local.get $fd))(i32.const 0))
       (then(return(i32.const -5))))
    (if (i32.ne(call $rename)(i32.const 0))
       (then(return(i32.const -5))))
    (local.set $dir(call $path(i32.const 9)(i32.const 1180)(i32.const 7)))
    (if (i32.lt_s(local.get $dir)(i32.const 0))(then(return(local.get $dir))))
    (if (i32.ne(call $next(local.get $dir))(i32.const 0))
       (then(return(i32.const -5))))
    (if (i32.ne(call $fd(i32.const 5)(local.get $dir))(i32.const 0))
       (then(return(i32.const -5))))
    (if (i32.ne(call $fd(i32.const 4)(local.get $dir))(i32.const 0))
       (then(return(i32.const -5))))
    (if (i32.ne(call $path(i32.const 11)(i32.const 1056)(i32.const 18))(i32.const 1))
       (then(return(i32.const -5))))
    (if (i32.ne(call $path(i32.const 8)(i32.const 1140)(i32.const 16))(i32.const 0))
       (then(return(i32.const -5))))
    (local.set $dir(call $path(i32.const 9)(i32.const 1180)(i32.const 7)))
    (if (i32.lt_s(local.get $dir)(i32.const 0))(then(return(local.get $dir))))
    (if (i32.ne(call $fd(i32.const 5)(local.get $dir))(i32.const 0))
       (then(return(i32.const -5))))
    (drop (call $fd(i32.const 4)(local.get $dir)))
    (if (i32.ne(call $random)(i32.const 0))(then(return(i32.const -5))))
    (if (i32.ne(call $write(local.get $output)(i32.const 1220)(i32.const 2))
       (i32.const 2))(then(return(i32.const -5))))
    (i32.const 0)))
