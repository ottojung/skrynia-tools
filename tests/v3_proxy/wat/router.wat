(module
 (import "skrynia" "read" (func $read(param i32 i32 i32)(result i32)))
 (import "skrynia" "invoke" (func $invoke(param i32 i32 i32 i32)(result i32)))
 (memory (export "memory") 1)
 (data (i32.const 64) "programs/nested.wasm")
 (func (export "skrynia_main") (param $in i32)(param $out i32)(result i32)
   (local $n i32)
   (local.set $n(call $read(local.get $in)(i32.const 0)(i32.const 1)))
   (if (i32.ne(local.get $n)(i32.const 1))
       (then(return(i32.const -5))))
   (i32.store8(i32.const 128)(i32.const 13))
   (i32.store(i32.const 129)(i32.const 20))
   (memory.copy(i32.const 133)(i32.const 64)(i32.const 20))
   (i32.store(i32.const 153)(local.get $in))
   (i32.store(i32.const 157)(local.get $out))
   (local.set $n(call $invoke(i32.const 128)(i32.const 33)
                        (i32.const 256)(i32.const 4)))
   (if (i32.ne(local.get $n)(i32.const 4))
       (then(return(i32.const -5))))
   (i32.load(i32.const 256))))
