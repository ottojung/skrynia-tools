(module
  (import "skrynia" "open_disk" (func $open(param i32 i32 i32)(result i32)))
  (import "skrynia" "read" (func $read(param i32 i32 i32)(result i32)))
  (import "skrynia" "write" (func $write(param i32 i32 i32)(result i32)))
  (import "skrynia" "close" (func $close(param i32)(result i32)))
  (import "skrynia" "eval"
    (func $eval(param i32 i32 i32 i32 i32 i32 i32)(result i32)))
  (memory(export "memory") 128)
  (table(export "__indirect_function_table") 1 funcref)
  (data(i32.const 0) "v2.wasm")
  (data(i32.const 64) "\01abcdef")
  (func $callback(param $p i32)(param $l i32)(param $o i32)(param $cap i32)(result i32)
    (if (i32.lt_s (local.get $l)(i32.const 3))(then(return(i32.const -4))))
    (if (i32.ne (i32.load8_u(local.get $p))(i32.const 1))
      (then(return(i32.const -4))))
    (if (i32.lt_s(local.get $cap)(i32.const 7))
      (then(return(i32.const -11))))
    (memory.copy (local.get $o)(i32.const 64)(i32.const 7))
    (i32.const 7))
  (elem(i32.const 0) func $callback)
  ;; Test-only diagnostic: expose numeric VM error to the test harness.
  (func $err(param $out i32)(param $code i32)(result i32)
    (i32.store(i32.const 6200000)(local.get $code))
    (drop(call $write(local.get $out)(i32.const 6200000)(i32.const 4)))
    (i32.const 0))
  (func(export "skrynia_main")(param $input i32)(param $output i32)(result i32)
    (local $code_fd i32)(local $code_len i32)(local $piece i32)(local $body_len i32)(local $answer i32)
    (local.set $code_fd (call $open(i32.const 0)(i32.const 7)(i32.const 1)))
    (if (i32.lt_s (local.get $code_fd)(i32.const 0))
      (then(return(call $err(local.get $output)(local.get $code_fd)))))
    (block $eof (loop $fill
      (local.set $piece (call $read (local.get $code_fd)
        (i32.add(i32.const 1024)(local.get $code_len))(i32.const 65536)))
      (if (i32.lt_s(local.get $piece)(i32.const 0))
        (then(return(call $err(local.get $output)(local.get $piece)))))
      (br_if $eof (i32.eqz(local.get $piece)))
      (local.set $code_len (i32.add(local.get $code_len)(local.get $piece)))
      (if (i32.gt_u(local.get $code_len)(i32.const 2000000))
        (then(return(call $err(local.get $output)(i32.const -10)))))
      (br $fill)))
    (drop(call $close(local.get $code_fd)))
    (if (i32.lt_s (local.get $code_len)(i32.const 0))
      (then(return(call $err(local.get $output)(local.get $code_len)))))
    (local.set $body_len
      (call $read(local.get $input)(i32.const 3000000)(i32.const 1048576)))
    (if (i32.lt_s (local.get $body_len)(i32.const 0))
      (then(return(call $err(local.get $output)(local.get $body_len)))))
    (local.set $answer (call $eval
      (i32.const 1024)(local.get $code_len)
      (i32.const 3000000)(local.get $body_len)
      (i32.const 0)(i32.const 4000000)(i32.const 1048576)))
    (if (i32.lt_s (local.get $answer)(i32.const 0))
      (then(return(call $err(local.get $output)(local.get $answer)))))
    (if (i32.ne (call $write(local.get $output)(i32.const 4000000)
      (local.get $answer))(local.get $answer))
      (then(return(i32.const -5))))
    (i32.const 0)))
